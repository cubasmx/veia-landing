---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";

const raiz = import.meta.env.BASE_URL;

const clientes = [
  { nombre: "SANHER Bienes Raíces", logo: `${raiz}images/logo-sanher.svg`, href: "https://sanherbienesraices.com/" },
  { nombre: "Legend Horizon Living", logo: `${raiz}images/logo-legend.webp`, href: "https://legendtower.com.mx/" },
  { nombre: "Uditore", logo: `${raiz}images/logo-uditore-full.png`, href: "https://uditore.mx/" },
  { nombre: "Tocomadera", logo: `${raiz}images/logo-tocomadera.png`, href: "https://tocomadera.mx/" },
  { nombre: "Ascendia", logo: `${raiz}img/ascendia-logo.png`, href: "https://ascendia.mx/", oscuro: true },
];
---

<Base titulo='Portafolio · VEIA'>
  <Header raiz={raiz} />
  <main>
    <!-- Hero compacto -->
    <section class="v-hero" style="padding-block:clamp(2.6rem,6vw,4.5rem);padding-inline:0">
      <div class="contenedor">
        <div class="v-hero__texto revelar">
          <span class="antetitulo">Trabajo real</span>
          <h1>Proyectos que hablan por nosotros</h1>
          <p class="destacado">Estos son algunos de los sitios web que hemos creado para nuestros clientes.</p>
        </div>
      </div>
    </section>

    <!-- Clientes -->
    <section class="seccion seccion--gris">
      <div class="contenedor">
        <div class="revelar">
          <span class="antetitulo">Clientes</span>
          <h2>Negocios que ya tienen presencia digital</h2>
        </div>
        <div class="v-clientes revelar" style="margin-top:2.4rem">
          {clientes.map((c) => (
            <a class:list={["v-cliente", c.oscuro && "v-cliente--oscuro"]} href={c.href} target="_blank" rel="noopener">
              <img src={c.logo} alt={c.nombre} loading="lazy" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Plantillas -->
    <section class="seccion">
      <div class="contenedor">
        <div class="revelar">
          <span class="antetitulo">Plantillas</span>
          <h2>Así parten nuestros sitios</h2>
          <p class="destacado" style="margin-top:0.8rem">
            Trabajamos sobre plantillas base por giro y las ajustamos a cada negocio. Puedes verlas y entender cómo
            funciona el soporte en su propia página.
          </p>
          <div class="v-hero__acciones">
            <a class="boton boton--degradado" href={`${raiz}plantillas/`}>Ver plantillas y soporte</a>
          </div>
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer raiz={raiz} />
</Base>
