---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BannerCTA from "../components/BannerCTA.astro";
import { ruta } from "../utils/ruta";

const clientes = [
  { nombre: "SANHER Bienes Raíces", logo: "images/logo-sanher.svg", href: "https://sanherbienesraices.com/" },
  { nombre: "Legend Horizon Living", logo: "images/logo-legend.webp", href: "https://legendtower.com.mx/" },
  { nombre: "Uditore", logo: "images/logo-uditore-full.png", href: "https://uditore.mx/" },
  { nombre: "Tocomadera", logo: "images/logo-tocomadera.png", href: "https://tocomadera.mx/" },
  { nombre: "Ascendia", logo: "img/ascendia-logo.png", href: "https://ascendia.mx/", clara: true },
];
---

<Base
  titulo="Portafolio | VEIA"
  descripcion="Sitios web hechos por VEIA para negocios de Guadalajara y Zapopan: SANHER, Legend Horizon Living, Uditore, Tocomadera y Ascendia."
>
  <Header />
  <main id="contenido">
    <section class="hero-compacto">
      <div class="contenedor">
        <div class="prosa">
          <span class="overline">Trabajo real</span>
          <h1>Proyectos que hablan por nosotros</h1>
          <p class="lead">Estos son algunos de los sitios web que hemos creado para nuestros clientes.</p>
        </div>
      </div>
    </section>

    <section class="seccion seccion--alterna" aria-labelledby="clientes-titulo">
      <div class="contenedor">
        <div class="seccion__cab">
          <span class="overline">Clientes</span>
          <h2 id="clientes-titulo">Negocios que ya tienen presencia digital</h2>
        </div>
        <div class="clientes-rejilla">
          {clientes.map((c) => (
            <a href={c.href} target="_blank" rel="noopener" title={c.nombre}>
              <img src={ruta(c.logo)} alt={c.nombre} height="32" loading="lazy" decoding="async" class:list={[c.clara && "clara"]} />
            </a>
          ))}
        </div>
      </div>
    </section>

    <BannerCTA
      h2="Cuéntanos sobre tu negocio o proyecto."
      texto="Queremos ver hasta dónde podemos llegar."
      boton="Escribir por WhatsApp"
      destino="whatsapp"
      mensaje="Hola, quiero hablar con VEIA sobre mi proyecto."
      secundario={{ texto: "Llamar por teléfono", href: "tel:+525659898908", icono: "telefono" }}
    />
  </main>
  <Footer />
</Base>
