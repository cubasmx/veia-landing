---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icono from "../components/Icono.astro";
import { ruta, whatsapp } from "../utils/ruta";

const whatsappPlantillas = whatsapp("Hola VEIA, quiero ver las plantillas");
const whatsappPlantillaConviene = whatsapp("Hola VEIA, quiero saber qué plantilla me conviene");

const plantillas = [
  { nombre: "Estética/Belleza", slug: "belleza", icono: "diseno" },
  { nombre: "Taller/Servicios", slug: "taller", icono: "equipo" },
  { nombre: "Tienda/Comercio", slug: "tienda", icono: "tienda" },
  { nombre: "Salud/Consultorio", slug: "salud", icono: "crm" },
  { nombre: "Profesional/Servicios", slug: "profesional", icono: "sitio" },
  { nombre: "Parroquia/Comunidad", slug: "parroquia", icono: "capas" },
];

const pasos = [
  {
    num: "01",
    titulo: "Elige el punto de partida",
    texto:
      "Revisas las plantillas de tu giro y eliges la que más se parece a lo que haces. Es un punto de partida, no el sitio final: ninguna plantilla sale igual a otra.",
  },
  {
    num: "02",
    titulo: "La ajustamos a tu negocio",
    texto:
      "Sobre esa base hacemos las modificaciones: textos, fotos, secciones, promociones, lo que haga falta para que se sienta tu negocio y no una plantilla más.",
  },
  {
    num: "03",
    titulo: "La mantenemos al día",
    texto:
      "El sitio entra a un plan de soporte, que arranca con 3 meses. Ahí caben los cambios del día a día: un precio nuevo, un menú, una promo que ya terminó, una foto que ya no aplica. Tú mandas el texto y las imágenes; nosotros lo subimos.",
  },
];

const esencial = [
  "Cambios de texto, precios y menús.",
  "Sustitución de fotos.",
  "Altas y retiro de promociones.",
  "Revisión de formularios y enlaces, para que sigan funcionando.",
  "Mantenimiento técnico menor y respaldos del sitio.",
  "Un resumen mensual de lo que se hizo.",
];

const activo = [
  "Altas de productos y catálogos, usando los componentes que ya tiene tu sitio.",
  "Cambios de contenido más frecuentes en el mismo mes.",
  "Las secciones y ajustes que vayan saliendo dentro de la bolsa de tiempo del mes.",
];

const aparte = [
  "Páginas o secciones nuevas.",
  "Rediseños.",
  "Funcionalidades nuevas.",
  "Tienda en línea e integraciones (pagos, sistemas o herramientas que ya uses).",
  "Redacción extensa de contenido.",
  "Diseño publicitario y fotografía.",
  "Campañas.",
  "Hosting, dominio y licencias.",
];
---

<Base
  titulo="Plantillas y soporte | VEIA"
  descripcion="Plantillas base por giro, ajuste a tu negocio y soporte mensual para mantener el sitio al día."
>
  <Header />
  <main id="contenido">
    <section class="hero-compacto">
      <div class="contenedor">
        <div class="prosa">
          <span class="overline">Plantillas y soporte</span>
          <h1>Una plantilla hecha, para empezar. Alguien que la mantenga, para que no se quede vieja.</h1>
          <p class="lead">
            Tenemos plantillas base por giro: belleza, taller, tienda, salud, despacho profesional y
            parroquia. Eliges la que se parece a tu negocio, la ajustamos con tus textos y tus fotos, y
            seguimos ahí: el sitio se mantiene al día sin que tengas que aprender a editarlo. Lo que se
            cotiza es el ajuste a tu negocio y el soporte para mantenerla al día.
          </p>
          <div class="hero__acciones">
            <a class="btn btn--primario" href={whatsappPlantillas} target="_blank" rel="noopener">
              Elegir mi plantilla por WhatsApp
            </a>
            <a class="btn btn--secundario" href="#demos">Ver las plantillas</a>
          </div>
        </div>
      </div>
    </section>

    <section class="seccion" id="demos">
      <div class="contenedor">
        <div class="seccion__cab">
          <span class="overline">Demos</span>
          <h2>Elige un punto de partida</h2>
          <p>Explora las plantillas base y mira la que más se parece a tu negocio.</p>
        </div>
        <div class="rejilla rejilla--3">
          {plantillas.map((p) => (
            <a class="tarjeta" href={ruta(`plantillas/${p.slug}/`)}>
              <Icono nombre={p.icono} tamano={28} clase="tarjeta__ico" />
              <h3>{p.nombre}</h3>
              <span class="enlace">Ver plantilla <Icono nombre="flecha" tamano={16} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="seccion seccion--alterna" aria-labelledby="como-funciona">
      <div class="contenedor">
        <div class="seccion__cab">
          <span class="overline">Cómo funciona</span>
          <h2 id="como-funciona">De la plantilla al sitio en tres pasos</h2>
        </div>
        <ol class="pasos">
          {pasos.map((p) => (
            <li class="paso">
              <span class="paso__num" aria-hidden="true">{p.num}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="seccion" aria-labelledby="soporte-titulo">
      <div class="contenedor">
        <div class="seccion__cab">
          <span class="overline">Soporte</span>
          <h2 id="soporte-titulo">Qué incluye el soporte</h2>
          <p>
            El soporte tiene dos niveles, Esencial y Activo. Los dos cubren cambios de contenido y
            mantenimiento técnico; la diferencia está en cuánto cabe al mes. El Activo es para negocios que
            mueven su sitio seguido: promociones, catálogo, cambios cada quince días.
          </p>
        </div>

        <div class="rejilla rejilla--2">
          <article class="tarjeta">
            <h3>Esencial</h3>
            <ul class="lista-check">
              {esencial.map((i) => <li>{i}</li>)}
            </ul>
          </article>
          <article class="tarjeta">
            <h3>Activo</h3>
            <p>Todo lo de Esencial, con más margen al mes para:</p>
            <ul class="lista-check">
              {activo.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        </div>

        <p class="prosa" style="margin-top:2.4rem">
          Cada nivel trae una bolsa de tiempo mensual para cambios de contenido. No es trabajo ilimitado:
          dentro de esa bolsa hacemos lo que nos pidas, y lo que se salga se cotiza aparte. De tu lado
          necesitamos los textos y las fotos listos; de este lado queda armarlos y publicarlos.
        </p>
      </div>
    </section>

    <section class="seccion seccion--alterna" aria-labelledby="aparte-titulo">
      <div class="contenedor">
        <div class="prosa">
          <span class="overline">Alcance</span>
          <h2 id="aparte-titulo">Qué se cotiza aparte</h2>
          <p>
            El soporte cubre lo que ya existe. Cuando se trata de algo nuevo, se cotiza aparte y con gusto
            lo armamos:
          </p>
          <ul class="lista-check" style="margin-top:1.2rem">
            {aparte.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cierre-plantillas">
      <div class="contenedor">
        <div class="cta__caja">
          <div class="cta__grid">
            <div>
              <h2 id="cierre-plantillas">¿Cuál plantilla se parece a tu negocio?</h2>
              <p>
                Dinos a qué te dedicas y en qué zona de Guadalajara o Zapopan atiendes. Te decimos qué
                plantilla conviene, qué habría que modificar y cómo quedaría el soporte. Sin compromiso y
                sin tecnicismos.
              </p>
            </div>
            <div class="cta__acciones">
              <a class="btn btn--claro" href={whatsappPlantillaConviene} target="_blank" rel="noopener">
                Escríbenos por WhatsApp
              </a>
              <a class="btn btn--contorno-claro" href={ruta("portafolio/")}>Ver el portafolio</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
