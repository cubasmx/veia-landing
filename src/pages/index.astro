---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Clientes from "../components/Clientes.astro";
import ServiciosGrid from "../components/ServiciosGrid.astro";
import Problema from "../components/Problema.astro";
import Proceso from "../components/Proceso.astro";
import Casos from "../components/Casos.astro";
import Diferenciadores from "../components/Diferenciadores.astro";
import FAQ from "../components/FAQ.astro";
import BannerCTA from "../components/BannerCTA.astro";
import Footer from "../components/Footer.astro";
import { home } from "../data/home";
import { ruta } from "../utils/ruta";

const organizacion = {
  "@type": "ProfessionalService",
  "@id": "https://veia.com.mx/#organizacion",
  name: "VEIA",
  url: "https://veia.com.mx/",
  telephone: "+525659898908",
  email: "contacto@veia.com.mx",
  description:
    "Soluciones tecnológicas para profesionistas, negocios locales y pymes: sitio web, tienda en línea, marca, publicidad, equipo de cómputo, CRM, ERP y desarrollo a medida.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guadalajara",
    addressRegion: "Jalisco",
    addressCountry: "MX",
  },
  areaServed: ["Guadalajara", "Zapopan", "Jalisco", "México"],
  knowsAbout: [
    "Diseño de páginas web",
    "Tiendas en línea",
    "Identidad visual",
    "Publicidad digital",
    "Equipo de cómputo y soporte",
    "CRM",
    "ERP",
    "Desarrollo de software a medida",
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organizacion,
    {
      "@type": "FAQPage",
      mainEntity: home.faq.preguntas.map((p) => ({
        "@type": "Question",
        name: p.q,
        acceptedAnswer: { "@type": "Answer", text: p.a },
      })),
    },
  ],
};
---

<Base titulo={home.seo.titulo} descripcion={home.seo.descripcion}>
  <Header home />
  <main id="contenido">
    <Hero />
    <Clientes />
    <ServiciosGrid />
    <Problema />
    <Proceso overline={home.proceso.overline} h2={home.proceso.h2} intro={home.proceso.intro} pasos={home.proceso.pasos} />
    <Casos />
    <section class="seccion seccion--equipo" aria-labelledby="equipo-titulo">
      <div class="contenedor equipo-home">
        <div>
          <span class="overline">Quiénes somos</span>
          <h2 id="equipo-titulo">Dos personas, no un call center.</h2>
        </div>
        <div class="equipo-home__texto">
          <p>
            VEIA es un equipo de dos personas en Guadalajara. Quien te contesta por WhatsApp es
            quien diseña, programa e implementa: sin ejecutivos de cuenta ni intermediarios.
          </p>
          <p class="equipo-home__firma"><strong>Julio</strong> y <strong>Ana Paula</strong> · Guadalajara, Jalisco</p>
        </div>
      </div>
    </section>
    <Diferenciadores />
    <FAQ overline={home.faq.overline} h2={home.faq.h2} preguntas={home.faq.preguntas} plantillas />
    <BannerCTA
      h2={home.cierre.h2}
      texto={home.cierre.texto}
      boton={home.cierre.primario}
      destino="whatsapp"
      mensaje="Hola, quiero hablar con VEIA sobre mi proyecto."
      secundario={{ texto: home.cierre.secundario, href: ruta("contacto/") }}
    />
  </main>
  <Footer home />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
