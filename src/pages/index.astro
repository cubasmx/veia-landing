---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Clientes from "../components/Clientes.astro";
import ServiciosGrid from "../components/ServiciosGrid.astro";
import Proceso from "../components/Proceso.astro";
import Casos from "../components/Casos.astro";
import Equipo from "../components/Equipo.astro";
import Diferenciadores from "../components/Diferenciadores.astro";
import FAQ from "../components/FAQ.astro";
import BannerCTA from "../components/BannerCTA.astro";
import Footer from "../components/Footer.astro";
import { home } from "../data/home";

const organizacion = {
  "@type": "ProfessionalService",
  "@id": "https://veia.com.mx/#organizacion",
  name: "VEIA",
  url: "https://veia.com.mx/",
  telephone: "+525659898908",
  email: "contacto@veia.com.mx",
  description:
    "Agencia para profesionistas, negocios locales y PyMEs: sitios web, automatización, tienda en línea, branding, diseño, redes sociales, sistemas IT, equipo de cómputo, servidores, cámaras de vigilancia, CRM, ERP, publicidad, APIs y desarrollo a medida.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Guadalajara",
    addressRegion: "Jalisco",
    addressCountry: "MX",
  },
  areaServed: ["Guadalajara", "Zapopan", "Jalisco", "México"],
  knowsAbout: [
    "Diseño de páginas web",
    "Automatización",
    "Tiendas en línea",
    "Branding y logos",
    "Diseño gráfico",
    "Redes sociales",
    "Sistemas IT",
    "Equipo de cómputo y servidores",
    "Cámaras de vigilancia",
    "CRM",
    "ERP",
    "Publicidad digital",
    "Desarrollo de APIs",
    "Desarrollo de software a medida",
    "Capacitación tecnológica",
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organizacion,
    {
      "@type": "FAQPage",
      mainEntity: home.faq.preguntas.map((p) => ({
        "@type": "Question",
        name: p.q,
        acceptedAnswer: { "@type": "Answer", text: p.a },
      })),
    },
  ],
};
---

<Base titulo={home.seo.titulo} descripcion={home.seo.descripcion}>
  <Header home />
  <main id="contenido">
    <Hero />
    <Clientes />
    <ServiciosGrid />
    <Proceso overline={home.proceso.overline} h2={home.proceso.h2} intro={home.proceso.intro} pasos={home.proceso.pasos} nota={home.proceso.nota} />
    <Casos />
    <Equipo />
    <Diferenciadores />
    <FAQ overline={home.faq.overline} h2={home.faq.h2} preguntas={home.faq.preguntas} />
    <BannerCTA
      h2={home.cierre.h2}
      texto={home.cierre.texto}
      boton={home.cierre.primario}
      destino="whatsapp"
      mensaje="Hola, quiero contarles sobre mi negocio o proyecto."
      secundario={{
        texto: home.cierre.secundario,
        href: `tel:+${home.cierre.telefono}`,
        icono: "telefono",
      }}
    />
  </main>
  <Footer home />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
