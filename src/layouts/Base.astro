---
import "../styles/global.css";

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
}
const { titulo, descripcion, noindex = false } = Astro.props;

const sitio = Astro.site ?? new URL("https://veia.com.mx");
const base = import.meta.env.BASE_URL;
const rutaCanonica = Astro.url.pathname.replace(base, "/");
const canonical = new URL(rutaCanonica, sitio).href;
const imagen = new URL("/img/logo-veia.png", sitio).href;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VEIA" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="theme-color" content="#570080" />

    <link rel="icon" type="image/png" href={`${base}favicon.png`} />

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
    <slot />

    <script>
      // Borde superior del header al hacer scroll.
      const header = document.querySelector("[data-header]");
      const marcarHeader = () => {
        header?.classList.toggle("con-borde", window.scrollY > 24);
      };
      marcarHeader();
      window.addEventListener("scroll", marcarHeader, { passive: true });

      // Desplegable "Servicios" (teclado y clic fuera).
      const sBtn = document.querySelector("[data-servicios-btn]");
      const sPanel = document.querySelector("[data-servicios-panel]");

      if (sBtn && sPanel) {
        const abrir = (abierto, foco = false) => {
          sPanel.classList.toggle("abierto", abierto);
          sBtn.setAttribute("aria-expanded", String(abierto));
          if (abierto && foco) {
            sPanel.querySelector("a, button")?.focus();
          }
        };

        sBtn.addEventListener("click", () => {
          abrir(!sPanel.classList.contains("abierto"));
        });

        sBtn.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") {
            e.preventDefault();
            abrir(true, true);
          }
        });

        document.addEventListener("click", (e) => {
          const t = e.target;
          if (!sPanel.contains(t) && !sBtn.contains(t)) abrir(false);
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && sPanel.classList.contains("abierto")) {
            abrir(false);
            sBtn.focus();
          }
        });

        sPanel.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => abrir(false));
        });
      }

      // Menú móvil a pantalla completa con foco atrapado.
      const mBtn = document.querySelector("[data-menu-btn]");
      const menu = document.querySelector("[data-menu-movil]");
      let focoPrevio = null;

      if (mBtn && menu) {
        const focusables = () =>
          Array.from(
            menu.querySelectorAll("a[href], button:not([disabled])")
          ).filter((el) => el.offsetParent !== null);

        const cerrarMenu = (devolverFoco) => {
          menu.classList.remove("abierto");
          menu.setAttribute("aria-hidden", "true");
          mBtn.setAttribute("aria-expanded", "false");
          mBtn.setAttribute("aria-label", "Abrir menú");
          document.body.classList.remove("menu-abierto");
          if (devolverFoco) (focoPrevio || mBtn).focus();
        };

        const abrirMenu = () => {
          focoPrevio = document.activeElement;
          menu.classList.add("abierto");
          menu.removeAttribute("aria-hidden");
          mBtn.setAttribute("aria-expanded", "true");
          mBtn.setAttribute("aria-label", "Cerrar menú");
          document.body.classList.add("menu-abierto");
          focusables()[0]?.focus();
        };

        menu.setAttribute("aria-hidden", "true");

        mBtn.addEventListener("click", () => {
          if (menu.classList.contains("abierto")) cerrarMenu(true);
          else abrirMenu();
        });

        menu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => cerrarMenu(false));
        });

        menu.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            e.preventDefault();
            cerrarMenu(true);
            return;
          }
          if (e.key !== "Tab") return;
          const f = focusables();
          if (!f.length) return;
          const primero = f[0];
          const ultimo = f[f.length - 1];
          if (e.shiftKey && document.activeElement === primero) {
            e.preventDefault();
            ultimo.focus();
          } else if (!e.shiftKey && document.activeElement === ultimo) {
            e.preventDefault();
            primero.focus();
          }
        });

        window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
          if (e.matches && menu.classList.contains("abierto")) cerrarMenu(false);
        });
      }

      // Aparición de secciones; respeta reduced-motion.
      const revelar = document.querySelectorAll(".revelar");
      const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (sinMovimiento || !("IntersectionObserver" in window)) {
        revelar.forEach((el) => el.classList.add("visto"));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("visto");
                observador.unobserve(entrada.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        revelar.forEach((el) => observador.observe(el));
      }

      // Videos de fondo (hero y proceso): se reproducen también en móvil.
      // Solo se omiten con movimiento reducido, ahorro de datos activo o red
      // 2G; en ese caso queda el póster. Cada video carga únicamente cuando se
      // acerca a la pantalla, así que la carga inicial en móvil sigue siendo
      // el póster (26 KB en el hero).
      const fondos = Array.from(document.querySelectorAll("[data-video-fondo]")) as HTMLVideoElement[];
      if (fondos.length) {
        const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");
        const conexion = (navigator as any).connection;
        let activo = false;

        const cerca = (video: HTMLVideoElement) => {
          const caja = video.getBoundingClientRect();
          return caja.bottom > -200 && caja.top < window.innerHeight + 400;
        };

        const cargar = (video: HTMLVideoElement) => {
          const fuente = video.dataset.fuente;
          if (fuente && video.getAttribute("src") !== fuente) {
            video.src = fuente;
            video.load();
          }
        };

        // iOS rechaza a veces play() justo después de load(): reintenta cuando
        // ya hay datos, si no el video se queda congelado en el primer cuadro.
        const reproducir = (video: HTMLVideoElement) => {
          const intento = video.play();
          if (intento) {
            intento.catch(() => {
              video.addEventListener(
                "canplay",
                () => video.play().catch(() => {}),
                { once: true }
              );
            });
          }
        };

        // Al desactivar (ahorro de datos, movimiento reducido) se suelta el
        // archivo para que vuelva a verse el póster y no quede un cuadro fijo.
        const soltar = (video: HTMLVideoElement) => {
          video.pause();
          if (video.hasAttribute("src")) {
            video.removeAttribute("src");
            video.load();
          }
        };

        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              const video = entrada.target as HTMLVideoElement;
              if (activo && entrada.isIntersecting && !document.hidden) {
                cargar(video);
                reproducir(video);
              } else {
                video.pause();
              }
            }
          },
          { rootMargin: "200px 0px", threshold: 0.1 }
        );

        const decidir = () => {
          const ahorraDatos = conexion?.saveData === true;
          const redLenta = /^(slow-)?2g$/.test(conexion?.effectiveType ?? "");
          activo = !menosMovimiento.matches && !ahorraDatos && !redLenta;
          for (const video of fondos) {
            observador.observe(video);
            if (activo && cerca(video) && !document.hidden) {
              cargar(video);
              reproducir(video);
            } else {
              soltar(video);
            }
          }
        };

        // Respaldo del IntersectionObserver: al hacer scroll, carga y reproduce
        // el video que ya está cerca (algunos navegadores retrasan el callback).
        window.addEventListener(
          "scroll",
          () => {
            if (!activo || document.hidden) return;
            for (const video of fondos) {
              if (cerca(video)) {
                cargar(video);
                if (video.paused) reproducir(video);
              }
            }
          },
          { passive: true }
        );

        decidir();
        menosMovimiento.addEventListener("change", decidir);
        conexion?.addEventListener?.("change", decidir);
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) fondos.forEach((v) => v.pause());
          else decidir();
        });
      }

      // Año del pie.
      document.querySelectorAll("[data-anio]").forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
    </script>
  </body>
</html>
