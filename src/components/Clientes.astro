---
import { home } from "../data/home";
import { ruta } from "../utils/ruta";

interface Props {
  rotulo?: string;
}
const { rotulo = home.clientes.rotulo } = Astro.props;
---

<section class="clientes" aria-label="Clientes">
  <div class="contenedor clientes__in revelar">
    <p class="clientes__rot">{rotulo}</p>
    {home.clientes.lista.map((c) => (
      <a href={c.href} target="_blank" rel="noopener" title={c.nombre}>
        <img
          src={ruta(c.logo)}
          alt={c.nombre}
          height={c.alto ? 30 : 26}
          class:list={[c.alto && "alto", c.clara && "clara"]}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))}
  </div>
</section>
