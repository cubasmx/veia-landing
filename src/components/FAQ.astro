---
interface Props {
  overline?: string;
  h2: string;
  preguntas: { q: string; a: string }[];
  id?: string;
  alterna?: boolean;
}
const { overline, h2, preguntas, id = "faq", alterna = false } = Astro.props;
---

<section class:list={["seccion", alterna && "seccion--alterna"]} id={id}>
  <div class="contenedor">
    <div class="seccion__cab">
      {overline && <span class="overline">{overline}</span>}
      <h2>{h2}</h2>
    </div>
    <div class="faq">
      {preguntas.map((p) => (
        <details>
          <summary>{p.q}</summary>
          <p>{p.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
