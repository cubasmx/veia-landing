---
import Icono from "./Icono.astro";
import { home } from "../data/home";
import { ruta } from "../utils/ruta";

const c = home.casos;
---

<section class="seccion" id="casos">
  <div class="contenedor">
    <div class="seccion__cab seccion__cab--dos">
      <div>
        <span class="overline">{c.overline}</span>
        <h2>{c.h2}</h2>
      </div>
      <p>{c.intro}</p>
    </div>

    <div class="casos revelar">
      {c.lista.map((caso) => (
        <article class="caso">
          <header>
            <img class="caso__logo" src={ruta(caso.logo)} alt={caso.cliente} height="32" loading="lazy" decoding="async" />
            <span class="caso__giro">{caso.giro}</span>
          </header>
          <div class="caso__bloque">
            <strong>El reto</strong>
            <p>{caso.reto}</p>
          </div>
          <div class="caso__bloque">
            <strong>Qué hicimos</strong>
            <p>{caso.hizo}</p>
          </div>
          <div class="caso__bloque">
            <strong>Hoy</strong>
            <p>{caso.hoy}</p>
          </div>
          <a class="enlace" href={caso.url} target="_blank" rel="noopener">
            Ver el sitio de {caso.cliente} <Icono nombre="flecha-arriba" tamano={16} />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
