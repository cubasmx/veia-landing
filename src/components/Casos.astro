---
// Prueba social contada: necesidad → qué hicimos → cómo se ve hoy.
//
// IMPORTANTE: aquí NO van cifras inventadas. Los resultados medibles
// (visitas, prospectos, ventas) quedan fuera hasta que cada cliente los
// confirme por escrito. Si se añaden, van con su fuente y su fecha.
//
// La redacción del reto y de la solución está basada en el proyecto
// entregado y en lo que el sitio muestra hoy; pendiente que cada cliente
// valide su versión antes de publicar.
const base = import.meta.env.BASE_URL;

const casos = [
  {
    cliente: "SANHER Bienes Raíces",
    giro: "Bienes raíces · Guadalajara",
    logo: `${base}images/logo-sanher.svg`,
    href: "https://sanherbienesraices.com/",
    problema:
      "Sus propiedades se movían por portales y recomendación de boca en boca. No tenían un sitio propio donde concentrar inventario y contacto.",
    solucion:
      "Landing con propiedades destacadas, información de la inmobiliaria, formulario y WhatsApp directo. Trabajo de SEO básico y presencia en Google para búsquedas locales.",
    hoy: "El sitio está en línea en su propio dominio, con las propiedades, el formulario y el WhatsApp a la mano del cliente.",
  },
  {
    cliente: "Tocomadera",
    giro: "Diseño de muebles y espacios",
    logo: `${base}images/logo-tocomadera.png`,
    href: "https://tocomadera.mx/",
    problema:
      "Su portafolio visual vivía disperso y era difícil mostrarlo a clientes residenciales, comerciales y corporativos.",
    solucion:
      "Sitio con portafolio organizado por tipo de proyecto (residencial, comercial, corporativo), galería de piezas y contacto directo para cotizar.",
    hoy: "El portafolio vive en tocomadera.mx, ordenado por tipo de proyecto y con contacto directo para cotizar.",
  },
  {
    cliente: "Uditore",
    giro: "Despacho contable y fiscal",
    logo: `${base}images/logo-uditore-full.png`,
    href: "https://uditore.mx/",
    problema:
      "Tienen muchos servicios y paquetes (SAT, contabilidad, impuestos, capacitación) y no había un lugar claro donde el cliente entendiera el alcance.",
    solucion:
      "Sitio con servicios explicados, paquetes por tipo de contribuyente, testimonios y canales de contacto visibles para reducir dudas repetidas.",
    hoy: "En uditore.mx los servicios y paquetes se explican por tipo de contribuyente, con los canales de contacto siempre visibles.",
  },
];
---

<section class="seccion" id="casos">
  <div class="contenedor">
    <div class="revelar">
      <span class="antetitulo">Casos</span>
      <h2>Trabajos reales, contados sin adornos</h2>
      <p class="destacado" style="margin-top:0.8rem">
        Qué necesitaba cada negocio, qué hicimos y cómo se ve hoy. Los sitios
        están en línea: puedes abrirlos y juzgar por ti mismo.
      </p>
    </div>

    <div class="v-casos revelar" style="margin-top:2.6rem">
      {casos.map((c) => (
        <article class="v-caso">
          <header class="v-caso__cabeza">
            <img class="v-caso__logo" src={c.logo} alt={c.cliente} loading="lazy" decoding="async" />
            <span class="v-caso__giro">{c.giro}</span>
          </header>

          <div class="v-caso__bloque">
            <span class="v-caso__etiqueta">El reto</span>
            <p>{c.problema}</p>
          </div>

          <div class="v-caso__bloque">
            <span class="v-caso__etiqueta">Qué hicimos</span>
            <p>{c.solucion}</p>
          </div>

          <div class="v-caso__bloque">
            <span class="v-caso__etiqueta">Hoy</span>
            <p>{c.hoy}</p>
          </div>

          <a class="v-caso__enlace" href={c.href} target="_blank" rel="noopener">
            Ver el sitio de {c.cliente} ↗
          </a>
        </article>
      ))}
    </div>

    <div class="revelar" style="margin-top:2.2rem;text-align:center">
      <a class="boton boton--contorno" href={`${base}portafolio/`}>Ver más proyectos</a>
    </div>
  </div>
</section>
