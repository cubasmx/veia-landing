---

<section class="seccion" id="precio">
  <div class="contenedor">
    <div class="revelar">
      <span class="antetitulo">Precios</span>
      <h2>Paquetes y servicios</h2>
      <p class="destacado" style="margin-top:0.8rem">
        Elige el alcance que necesitas; cada opción se cotiza directo por WhatsApp.
      </p>
    </div>

    <div class="v-rejilla v-rejilla--2 revelar" style="margin-top:2.6rem">
      {paquetes.map((p) => (
        <article class:list={["v-tarjeta", "v-tarjeta--paquete", p.destacado && "v-tarjeta--destacado"]}>
          <span class="antetitulo">{p.etiqueta}</span>
          <h3>{p.nombre}</h3>
          <p class="v-tarjeta__desc">{p.descripcion}</p>
          <div class="v-precio">{p.precio}</div>
          <p class="v-tarjeta__pago">{p.pago}</p>
          <ul class="v-mini">
            {p.incluye.map((i) => <li>{i}</li>)}
          </ul>
          <p class="v-oferta__nota">{p.nota}</p>
          <a class="boton boton--degradado" href={p.href} target="_blank" rel="noopener">
            Cotizar por WhatsApp
          </a>
        </article>
      ))}
    </div>

    <div class="v-rejilla v-rejilla--3 revelar" style="margin-top:1.2rem">
      {opcionales.map((o) => (
        <article class="v-tarjeta v-tarjeta--opcion">
          <span class="antetitulo">Opcional</span>
          <h3>{o.nombre}</h3>
          <div class="v-precio">{o.precio}{o.unidad ? <small>{o.unidad}</small> : null}</div>
          <p>{o.texto}</p>
          <a class="boton boton--contorno" href={o.href} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
        </article>
      ))}
    </div>
  </div>
</section>
