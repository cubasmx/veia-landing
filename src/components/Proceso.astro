---
import { ruta } from "../utils/ruta";

interface Paso {
  titulo: string;
  texto: string;
}
interface Props {
  overline?: string;
  h2: string;
  intro?: string;
  pasos: Paso[];
  nota?: string;
  id?: string;
}
const { overline, h2, intro, pasos, nota, id = "proceso" } = Astro.props;
const poster = ruta("video/proceso-poster.webp");
---

<section class="proceso" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="proceso__fondo" aria-hidden="true" style={`background-image:url(${poster})`}>
    <video
      class="proceso__video"
      data-video-fondo
      data-fuente={ruta("video/proceso-veia.mp4")}
      muted
      loop
      playsinline
      preload="none"
      poster={poster}
      tabindex="-1"
    ></video>
  </div>

  <div class="contenedor proceso__in">
    <div class="seccion__cab seccion__cab--dos revelar">
      <div>
        {overline && <span class="overline">{overline}</span>}
        <h2 id={`${id}-titulo`}>{h2}</h2>
      </div>
      {intro && <p>{intro}</p>}
    </div>

    <ol class="pasos revelar">
      {pasos.map((p, i) => (
        <li class="paso">
          <span class="paso__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>

    {nota && <p class="pasos__nota">{nota}</p>}
  </div>
</section>
