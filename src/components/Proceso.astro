---
interface Paso {
  titulo: string;
  texto: string;
  tiempo?: string;
}
interface Props {
  overline?: string;
  h2: string;
  intro?: string;
  pasos: Paso[];
  nota?: string;
  id?: string;
  alterna?: boolean;
}
const { overline, h2, intro, pasos, nota, id = "proceso", alterna = false } = Astro.props;
---

<section class:list={["seccion", alterna && "seccion--alterna"]} id={id}>
  <div class="contenedor">
    <div class="seccion__cab seccion__cab--dos">
      <div>
        {overline && <span class="overline">{overline}</span>}
        <h2>{h2}</h2>
      </div>
      {intro && <p>{intro}</p>}
    </div>
    <ol class="pasos">
      {pasos.map((p, i) => (
        <li class="paso">
          <span class="paso__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          {p.tiempo && <span class="paso__tiempo">{p.tiempo.replace(/^\d+\s*·\s*/, "")}</span>}
        </li>
      ))}
    </ol>
    {nota && <p class="pasos__nota">{nota}</p>}
  </div>
</section>
