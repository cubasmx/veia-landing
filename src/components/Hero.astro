---
import Icono from "./Icono.astro";
import CarruselServicios from "./CarruselServicios.astro";
import { home } from "../data/home";
import { resaltar, ruta, whatsapp } from "../utils/ruta";

const h = home.hero;
const cta = whatsapp("Hola, quiero contarles de mi negocio y lo que necesito.");
const poster = ruta("video/hero-veia-poster.webp");
---

<section class="hero" id="inicio">
  <div class="hero__fondo" aria-hidden="true" style={`background-image:url(${poster})`}>
    <video
      class="hero__video"
      data-video-fondo
      data-fuente={ruta("video/hero-veia.mp4")}
      muted
      loop
      playsinline
      preload="none"
      poster={poster}
      tabindex="-1"
    ></video>
  </div>

  <div class="contenedor hero__grid">
    <div class="hero__texto revelar">
      <span class="overline">{h.overline}</span>
      <h1 class="display" set:html={resaltar(h.h1)} />
      <p class="lead">{h.lead}</p>
      <div class="hero__acciones">
        <a class="btn btn--claro" href={cta} target="_blank" rel="noopener">
          {h.primario} <Icono nombre="flecha" tamano={18} />
        </a>
      </div>
      <ul class="confianza" aria-label="Cómo trabajamos">
        {h.confianza.map((c) => (
          <li><Icono nombre="check" tamano={16} /> {c}</li>
        ))}
      </ul>
    </div>

    <CarruselServicios />
  </div>
</section>
