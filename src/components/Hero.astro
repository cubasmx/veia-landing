---
import Icono from "./Icono.astro";
import { home } from "../data/home";
import { resaltar, whatsapp } from "../utils/ruta";

const h = home.hero;
const cta = whatsapp("Hola, quiero agendar un diagnóstico con VEIA.");
---

<section class="hero" id="inicio">
  <div class="contenedor hero__grid">
    <div class="revelar">
      <span class="overline">{h.overline}</span>
      <h1 class="display" set:html={resaltar(h.h1)} />
      <p class="lead">{h.lead}</p>
      <div class="hero__acciones">
        <a class="btn btn--primario" href={cta} target="_blank" rel="noopener">
          {h.primario} <Icono nombre="flecha" tamano={18} />
        </a>
        <a class="btn btn--secundario" href="#servicios">{h.secundario}</a>
      </div>
      <ul class="confianza" aria-label="Cómo trabajamos">
        {h.confianza.map((c) => (
          <li><Icono nombre="check" tamano={16} /> {c}</li>
        ))}
      </ul>
    </div>

    <aside class="panel revelar" aria-label="Lo que resolvemos">
      <div class="panel__cab">
        <h2>{h.panel.titulo}</h2>
        <span class="pill">{h.panel.pill}</span>
      </div>
      <ul>
        {h.panel.filas.map((f) => (
          <li>
            <Icono nombre={f.icono} tamano={24} />
            <span>{f.nombre} <small>{f.nota}</small></span>
          </li>
        ))}
      </ul>
      <p class="panel__pie">
        <Icono nombre="ubicacion" tamano={16} />
        {h.panel.nota}
      </p>
    </aside>
  </div>
</section>
