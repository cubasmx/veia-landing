---
const base = import.meta.env.BASE_URL;
const whatsapp = "https://wa.me/525659898908?text=Hola%20VEIA,%20quiero%20cotizar%20mi%20presencia%20digital";
---

<section class="v-hero" data-hero>
  <div class="contenedor v-hero__grid">
    <div class="v-hero__texto revelar">
      <span class="antetitulo">Sitios web y catálogos para tu negocio</span>
      <h1>Tu negocio listo para <span class="acento-serif">vender</span> en internet.</h1>
      <p class="destacado">
        Digitalizamos negocios: sitio web, catálogo de productos, presencia en Google y WhatsApp
        listos para vender. Sin soluciones gigantes ni procesos enredados.
      </p>
      <div class="v-hero__acciones">
        <a class="boton boton--degradado" href={whatsapp} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
        <a class="boton boton--contorno" href="#precio">Ver precio y alcance</a>
      </div>
    </div>

    <div class="v-hero__mockup revelar">
      <div class="v-blob" aria-hidden="true"></div>
      <div class="v-telefono" aria-hidden="true">
        <div class="v-telefono__barra">
          <img class="v-telefono__logo-img" src={`${base}img/logo-veia.png`} alt="" width="38" height="14" />
        </div>
        <div class="v-telefono__pantalla">
          <div class="v-telefono__hero-mini">
            Tu negocio, <em>listo para vender</em>
          </div>
          <div class="v-linea v-linea--media"></div>
          <div class="v-linea v-linea--corta"></div>
          <div class="v-telefono__tarjeta">
            <span class="v-linea" style="width:70%"></span>
            <span class="v-linea v-linea--media"></span>
          </div>
          <div class="v-linea v-linea--media"></div>
          <span class="v-telefono__pildora">Cotizar</span>
        </div>
      </div>
    </div>
  </div>
</section>
