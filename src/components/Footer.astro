---
import { servicios } from "../data/servicios";
import { ruta, whatsapp } from "../utils/ruta";

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const ir = (ancla: string) => {
  if (ancla === "#inicio" && !home) return ruta("");
  if (ancla === "#contacto" && !home) return ruta("contacto/");
  return home ? ancla : ruta(ancla);
};
const wsp = whatsapp("Hola, quiero información sobre los servicios de VEIA.");
---

<footer class="footer oscuro">
  <div class="contenedor">
    <div class="footer__grid">
      <div>
        <a href={ir("#inicio")} aria-label="VEIA, inicio">
          <img src={ruta("img/veia-logo-blanco.png")} alt="VEIA" width="97" height="28" />
        </a>
        <p class="footer__frase">Un equipo pequeño, del sitio al sistema.</p>
      </div>

      <nav aria-label="Servicios">
        <h2 class="footer__titulo">Servicios</h2>
        <ul>
          {servicios.map((s) => (
            <li><a href={ruta(`servicios/${s.slug}/`)}>{s.nombre}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Empresa">
        <h2 class="footer__titulo">Empresa</h2>
        <ul>
          <li><a href={ir("#casos")}>Casos</a></li>
          <li><a href={ir("#proceso")}>Cómo trabajamos</a></li>
          <li><a href={ir("#faq")}>Dudas</a></li>
          <li><a href={ir("#contacto")}>Contacto</a></li>
        </ul>
      </nav>

      <div class="footer__contacto">
        <h2 class="footer__titulo">Contacto</h2>
        <p><a href={wsp} target="_blank" rel="noopener">WhatsApp 56 5989 8908</a></p>
        <p><a href="mailto:contacto@veia.com.mx">contacto@veia.com.mx</a></p>
        <p>Guadalajara y Zapopan, Jalisco</p>
        <p>L–V 9:00–18:00 (hora CDMX)</p>
      </div>
    </div>

    <div class="footer__base">
      <p>© <span data-anio>2026</span> VEIA. Todos los derechos reservados.</p>
      <p>
        <a href={ruta("aviso-de-privacidad/")}>Aviso de privacidad</a>
        <span aria-hidden="true"> · </span>
        Hecho en Guadalajara
      </p>
    </div>
  </div>
</footer>
