---
import RedesSociales from "./RedesSociales.astro";
import { MOSTRAR_PAQUETES } from "../config";

const { raiz = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const contacto = [
  { texto: "WhatsApp: 56 5989 8908", href: "https://wa.me/525659898908" },
  { texto: "contacto@veia.com.mx", href: "mailto:contacto@veia.com.mx" },
  { texto: "Guadalajara · Zapopan, Jal.", href: null },
];
const explorar = [
  { texto: "Servicios", href: `${raiz}#piezas` },
  { texto: "Casos", href: `${raiz}#casos` },
  ...(MOSTRAR_PAQUETES ? [{ texto: "Precios", href: `${raiz}#precio` }] : []),
  { texto: "Dudas frecuentes", href: `${raiz}#faq` },
  { texto: "Plantillas y soporte", href: `${raiz}plantillas/` },
  { texto: "Portafolio", href: `${raiz}portafolio/` },
];
---

<footer class="v-footer" id="contacto">
  <div class="contenedor">
    <div class="v-footer__grid">
      <div>
        <a class="v-marca" href={`${raiz}#inicio`} aria-label="VEIA · Presencia digital para negocios locales">
          <img class="v-marca__logo" src={`${base}img/veia-logo-blanco.png`} alt="VEIA" width="97" height="30" />
        </a>
        <p style="max-width:30em">Digitalizamos negocios locales: sitio web, presencia en Google y WhatsApp listos para vender.</p>
        <div class="v-footer__redes">
          <h4>Síguenos</h4>
          <RedesSociales variante="footer" />
        </div>
      </div>
      <div>
        <h4>Explorar</h4>
        <ul>
          {explorar.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          {contacto.map((c) => (
            <li>{c.href ? <a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined}>{c.texto}</a> : c.texto}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="v-footer__bottom">© <span id="anio"></span> VEIA · Guadalajara · Zapopan, Jal.</div>
  </div>
</footer>
