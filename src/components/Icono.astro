  )}
  {nombre === "flecha-abajo" && (
    <path d="M6 9l6 6 6-6" />
  )}
  {nombre === "flecha-arriba" && (
    <Fragment>
      <path d="M7 17 17 7" />
      <path d="M8 7h9v9" />
    </Fragment>
  )}
  {nombre === "ubicacion" && (
    <Fragment>
      <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" />
