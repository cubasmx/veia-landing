      <rect x="3" y="13" width="8" height="8" rx="1.5" />
      <path d="M17 13v4.5m0 0 2-2m-2 2-2-2" />
    </Fragment>
  )}
  {nombre === "desarrollo" && (
    <Fragment>
      <path d="M8 4H6.5A1.5 1.5 0 0 0 5 5.5v13A1.5 1.5 0 0 0 6.5 20H8M16 4h1.5A1.5 1.5 0 0 1 19 5.5v13a1.5 1.5 0 0 1-1.5 1.5H16" />
