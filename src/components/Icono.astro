  )}
  {nombre === "capas" && (
    <Fragment>
      <path d="m12 3 8.5 4.5L12 12 3.5 7.5Z" />
      <path d="m4 12 8 4.2 8-4.2" />
      <path d="m4 16.5 8 4.2 8-4.2" />
