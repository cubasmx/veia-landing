  )}
  {nombre === "whatsapp" && (
    <path
      d="M12 3.2a8.6 8.6 0 0 0-7.3 13.1L3.5 20.8l4.6-1.2A8.6 8.6 0 1 0 12 3.2Zm0 15.7c-1.4 0-2.7-.4-3.8-1.1l-.3-.2-2.2.6.7-2.1-.2-.4a7 7 0 1 1 5.8 3.2Zm4-5.2c-.2-.1-1.3-.6-1.5-.7-.2-.1-.3-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a5.8 5.8 0 0 1-2.9-2.5c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.4l-.6-1.6c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.5 3.9 3.4 1.4.6 2 .6 2.7.5.4-.1 1.3-.5 1.5-1s.2-.9.1-1l-.7-.6Z"
