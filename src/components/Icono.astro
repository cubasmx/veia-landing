---
// Set de iconos lineales 24×24, trazo 1.5. Decorativos por defecto.
interface Props {
  nombre: string;
  tamano?: number;
  clase?: string;
  titulo?: string;
}
const { nombre, tamano = 24, clase = "", titulo } = Astro.props;
const a11y = titulo
  ? { role: "img", "aria-label": titulo }
  : { "aria-hidden": "true" as const };
---

<svg
  class={clase}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {nombre === "sitio" && (
    <Fragment>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M3 8.5h18" />
      <path d="M6 6.3h.01M8.4 6.3h.01" />
      <path d="M7 12h6M7 15.5h10" />
    </Fragment>
  )}
  {nombre === "tienda" && (
    <Fragment>
      <path d="M5 8h14l-1.2 12.2a1.6 1.6 0 0 1-1.6 1.4H7.8a1.6 1.6 0 0 1-1.6-1.4Z" />
      <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
      <circle cx="12" cy="14" r="1.1" fill="var(--magenta)" stroke="none" />
    </Fragment>
  )}
  {nombre === "diseno" && (
    <Fragment>
      <circle cx="9" cy="9" r="5" />
