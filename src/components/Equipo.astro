---
import Icono from "./Icono.astro";
import { home } from "../data/home";
import { ruta } from "../utils/ruta";

const e = home.equipo;
---

<section class="seccion seccion--equipo" id="equipo" aria-labelledby="equipo-titulo">
  <div class="contenedor">
    <div class="seccion__cab revelar">
      <span class="overline">{e.overline}</span>
      <h2 id="equipo-titulo">{e.h2}</h2>
    </div>

    <div class="equipo revelar">
      {e.personas.map((p) => (
        <article class="persona">
          <div class="persona__foto">
            <img
              src={ruta(p.foto)}
              alt={`${p.nombre}, ${p.rol} en VEIA`}
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="persona__cuerpo">
            <h3>{p.nombre}</h3>
            <p class="persona__rol">{p.rol}</p>
            <a class="enlace" href={p.portafolio} target="_blank" rel="noopener">
              {e.enlace} <Icono nombre="flecha" tamano={16} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
