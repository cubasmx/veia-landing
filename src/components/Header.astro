---
import RedesSociales from "./RedesSociales.astro";
import { MOSTRAR_PAQUETES } from "../config";

const { raiz = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const enlaces = [
  { href: "#inicio", texto: "Inicio" },
  { href: "#piezas", texto: "Servicios" },
  { href: "#casos", texto: "Casos" },
  ...(MOSTRAR_PAQUETES ? [{ href: "#precio", texto: "Precios" }] : []),
  { href: "plantillas/", texto: "Plantillas" },
  { href: "#faq", texto: "Dudas" },
  { href: "#contacto", texto: "Contacto" },
];
---

<header class="v-header" id="inicio">
  <div class="contenedor v-header__inner">
    <a class="v-marca" href={`${raiz}#inicio`} aria-label="VEIA · Presencia digital para negocios locales">
      <img class="v-marca__logo" src={`${base}img/logo-veia.png`} alt="VEIA" width="83" height="30" />
    </a>

    <nav class="v-nav" aria-label="Secciones">
      {enlaces.map((e) => <a href={`${raiz}${e.href}`}>{e.texto}</a>)}
    </nav>

    <div class="v-header__acciones">
      <RedesSociales variante="header" />
      <a class="boton boton--oscuro" href="https://wa.me/525659898908?text=Hola%20VEIA,%20quiero%20digitalizar%20mi%20negocio" target="_blank" rel="noopener">
        Cotizar
      </a>
      <button class="v-menu-btn" data-menu-btn aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="v-menu-movil" id="menu-movil" data-menu-movil>
  {enlaces.map((e) => <a href={`${raiz}${e.href}`}>{e.texto}</a>)}
  <a class="boton boton--degradado" style="margin-top:1.2rem;width:100%" href="https://wa.me/525659898908?text=Hola%20VEIA,%20quiero%20digitalizar%20mi%20negocio" target="_blank" rel="noopener">
    Cotizar por WhatsApp
  </a>
  <div class="v-menu-movil__redes">
    <span class="antetitulo" style="margin-bottom:0.5rem">Síguenos</span>
    <RedesSociales variante="menu" />
  </div>
</div>
